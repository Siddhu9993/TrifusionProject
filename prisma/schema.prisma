generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH
// ============================================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("ADMIN") // ADMIN | EDITOR
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leadNotes LeadNote[]
}

// ============================================================
// LEADS / CONTACT
// ============================================================

model Lead {
  id                     String     @id @default(uuid())
  leadRef                String     @unique // e.g. TF-2026-0001
  name                   String
  email                  String
  phone                  String?
  company                String?
  serviceInterest        String?
  projectType            String?
  budgetRange            String?
  preferredContactMethod String?
  message                String
  status                 String     @default("NEW") // NEW | CONTACTED | QUALIFIED | PROPOSAL | NEGOTIATION | WON | LOST
  source                 String     @default("WEBSITE")
  ipAddress              String?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  notes LeadNote[]
}

model LeadNote {
  id        String   @id @default(uuid())
  leadId    String
  userId    String
  note      String
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
}

// Keep old model for backward compatibility during migration
model ContactLead {
  id              String   @id @default(uuid())
  name            String
  email           String
  company         String?
  serviceInterest String?
  message         String
  status          String   @default("NEW")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================================
// SERVICES / SOLUTIONS
// ============================================================

model Service {
  id           String   @id @default(uuid())
  slug         String   @unique
  title        String
  shortDesc    String
  description  String
  icon         String?
  heroImage    String?
  problemStatement String?
  sortOrder    Int      @default(0)
  published    Boolean  @default(false)
  featured     Boolean  @default(false)
  seoTitle     String?
  seoDesc      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  features     ServiceFeature[]
  technologies ServiceTechnology[]
  industries   IndustryService[]
  caseStudies  CaseStudyService[]
  faqs         FAQ[]
}

model ServiceFeature {
  id        String  @id @default(uuid())
  serviceId String
  title     String
  desc      String?
  icon      String?
  sortOrder Int     @default(0)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model ServiceTechnology {
  id        String @id @default(uuid())
  serviceId String
  name      String
  category  String?
  icon      String?

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

// ============================================================
// INDUSTRIES
// ============================================================

model Industry {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  shortDesc   String
  description String?
  icon        String?
  heroImage   String?
  challenges  String?  // JSON array stored as string
  outcomes    String?  // JSON array stored as string
  sortOrder   Int      @default(0)
  published   Boolean  @default(false)
  seoTitle    String?
  seoDesc     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services    IndustryService[]
  caseStudies CaseStudy[]
  faqs        FAQ[]
}

model IndustryService {
  id         String @id @default(uuid())
  industryId String
  serviceId  String

  industry Industry @relation(fields: [industryId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([industryId, serviceId])
}

// ============================================================
// PRODUCTS
// ============================================================

model Product {
  id           String   @id @default(uuid())
  slug         String   @unique
  name         String
  tagline      String?
  description  String
  logo         String?
  heroImage    String?
  category     String?
  status       String   @default("ACTIVE") // ACTIVE | BETA | COMING_SOON | DEPRECATED
  externalUrl  String?
  targetIndustry String?
  published    Boolean  @default(false)
  featured     Boolean  @default(false)
  sortOrder    Int      @default(0)
  seoTitle     String?
  seoDesc      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  features     ProductFeature[]
  technologies ProductTechnology[]
  screenshots  ProductScreenshot[]
}

model ProductFeature {
  id        String  @id @default(uuid())
  productId String
  title     String
  desc      String?
  icon      String?
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductTechnology {
  id        String @id @default(uuid())
  productId String
  name      String
  category  String?
  icon      String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductScreenshot {
  id        String @id @default(uuid())
  productId String
  url       String
  alt       String?
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ============================================================
// CASE STUDIES
// ============================================================

model CaseStudy {
  id           String   @id @default(uuid())
  slug         String   @unique
  title        String
  clientName   String?
  industryId   String?
  overview     String?
  challenge    String?
  objectives   String?  // JSON array as string
  solution     String?
  architecture String?
  timeline     String?
  published    Boolean  @default(false)
  featured     Boolean  @default(false)
  heroImage    String?
  sortOrder    Int      @default(0)
  seoTitle     String?
  seoDesc      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  industry     Industry?           @relation(fields: [industryId], references: [id])
  metrics      CaseStudyMetric[]
  technologies CaseStudyTechnology[]
  images       CaseStudyImage[]
  services     CaseStudyService[]
  testimonial  Testimonial?
}

model CaseStudyMetric {
  id          String @id @default(uuid())
  caseStudyId String
  label       String
  value       String
  description String?
  sortOrder   Int    @default(0)

  caseStudy CaseStudy @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)
}

model CaseStudyTechnology {
  id          String @id @default(uuid())
  caseStudyId String
  name        String
  category    String?
  icon        String?

  caseStudy CaseStudy @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)
}

model CaseStudyImage {
  id          String  @id @default(uuid())
  caseStudyId String
  url         String
  alt         String?
  caption     String?
  sortOrder   Int     @default(0)

  caseStudy CaseStudy @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)
}

model CaseStudyService {
  id          String @id @default(uuid())
  caseStudyId String
  serviceId   String

  caseStudy CaseStudy @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)
  service   Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([caseStudyId, serviceId])
}

// ============================================================
// TESTIMONIALS
// ============================================================

model Testimonial {
  id          String   @id @default(uuid())
  caseStudyId String?  @unique
  name        String
  title       String?
  company     String?
  avatar      String?
  quote       String
  rating      Int?     @default(5) // 1-5
  published   Boolean  @default(false)
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  caseStudy CaseStudy? @relation(fields: [caseStudyId], references: [id])
}

// ============================================================
// FAQs
// ============================================================

model FAQCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  faqs FAQ[]
}

model FAQ {
  id         String   @id @default(uuid())
  question   String
  answer     String
  categoryId String?
  serviceId  String?
  industryId String?
  published  Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category FAQCategory? @relation(fields: [categoryId], references: [id])
  service  Service?     @relation(fields: [serviceId], references: [id])
  industry Industry?    @relation(fields: [industryId], references: [id])
}

// ============================================================
// BLOG / INSIGHTS
// ============================================================

model BlogCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts BlogPost[]
}

model BlogPost {
  id           String   @id @default(uuid())
  slug         String   @unique
  title        String
  excerpt      String?
  content      String
  featuredImage String?
  author       String?
  categoryId   String?
  tags         String?  // JSON array as string
  readingTime  Int?     // minutes
  published    Boolean  @default(false)
  featured     Boolean  @default(false)
  publishedAt  DateTime?
  seoTitle     String?
  seoDesc      String?
  ogImage      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category BlogCategory? @relation(fields: [categoryId], references: [id])
}

// ============================================================
// CAREERS / JOBS
// ============================================================

model Job {
  id             String   @id @default(uuid())
  slug           String   @unique
  title          String
  department     String?
  location       String?
  employmentType String?  // FULL_TIME | PART_TIME | CONTRACT | INTERNSHIP
  experience     String?
  description    String?
  responsibilities String? // JSON array as string
  requirements   String?  // JSON array as string
  benefits       String?  // JSON array as string
  salaryRange    String?
  published      Boolean  @default(false)
  closingDate    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  applications JobApplication[]
}

model JobApplication {
  id          String   @id @default(uuid())
  jobId       String
  name        String
  email       String
  phone       String?
  resumeUrl   String?
  linkedin    String?
  portfolio   String?
  coverMessage String?
  status      String   @default("PENDING") // PENDING | REVIEWING | SHORTLISTED | REJECTED | HIRED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

// ============================================================
// SITE SETTINGS / CONFIG
// ============================================================

model SiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String?
  label     String?
  group     String?  // CONTACT | SOCIAL | SEO | GENERAL
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SocialLink {
  id        String   @id @default(uuid())
  platform  String   @unique // LINKEDIN | TWITTER | GITHUB | YOUTUBE | INSTAGRAM
  url       String
  icon      String?
  published Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
