{
  "name": "trifusion-technology",
  "version": "1.0.0",
  "description": "Trifusion Technology LLP — Official Website & Platform",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev:api": "npx tsx watch src/server.ts",
    "dev:web": "cd web && npm run dev",
    "dev": "npx concurrently -n API,WEB -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "postinstall": "cd web && npm install --no-audit",
    "build:api": "npx tsc",
    "build:web": "cd web && npm run build",
    "build": "npm run build:api && npm run build:web",
    "start:api": "node dist/server.js",
    "start:web": "cd web && npm start",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "typecheck:web": "cd web && node node_modules/typescript/bin/tsc --noEmit",
    "lint": "cd web && npm run lint",
    "test": "echo \"No tests configured yet\" && exit 0"
  },
  "keywords": [
    "trifusion",
    "technology",
    "software",
    "saas",
    "web"
  ],
  "author": "Trifusion Technology LLP",
  "license": "UNLICENSED",
  "dependencies": {
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "googleapis": "^174.0.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.2",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
